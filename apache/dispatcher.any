/farms {
  /filtertestfarm {
    /clientheaders {
      "*"
    }
    /virtualhosts {
      "*"
    }
    /renders {
      /rend01 {
        /hostname "127.0.0.1"
        /port "4503"
        /timeout "0"
      }
    }
    /filter {
      $include "/etc/httpd/conf.dispatcher.d/sandbox_policy.any"
      /default-test-container-allow-404 { /type "allow" /method "GET" /url "/container-404.html" /extension "html" /selectors "" /suffix "" }
      /default-test-container-allow-favicon { /type "allow" /method "GET" /url "/favicon.ico" /extension "ico" /selectors "" /suffix "" }
      # Generated: includes filters/*.any, or an allow-all stub when testing ModSecurity only
      $include "/etc/httpd/conf.dispatcher.d/sandbox_filters.any"
    }
    /cache {
      /rules {
        /0000 {
          /glob "*"
          /type "deny"
        }
      }
    }
  }
}
